        "type": "trigger",
        "label": "On PurchaseRequest Submit",
        "trigger": {
          "type": "on-field-change",
          "fieldName": "status",
          "resourceName": "PurchaseRequest"
        },
        "position": {
          "x": 300,
          "y": 50
        }
      },
      {
        "id": "gen_1789239108279_2",
        "type": "condition",
        "label": "Status = PendingManagerApproval?",
        "position": {
          "x": 300,
          "y": 160
        },
        "condition": {
          "logic": "and",
          "rules": [
            {
              "field": "triggerData.status",
              "value": "1",
              "operator": "equals"
            }
          ]
        }
      },
      {
        "id": "gen_1789239108279_4",
        "type": "approval",
        "label": "PurchaseRequest Approval",
        "approval": {
          "steps": [
            {
              "name": "Birim Müdürü Onayı",
              "actions": [
                {
                  "type": "approve",
                  "label": "Onayla"
                },
                {
                  "type": "revise",
                  "label": "Reddet",
                  "requiredFields": [
                    "rejectionReason"
                  ]
                }
              ],
              "assigneeType": "role",
              "assigneeValue": "DepartmentManager"
            },
            {
              "name": "Finans Onayı",
              "actions": [
                {
                  "type": "approve",
                  "label": "Onayla"
                },
                {
                  "type": "revise",
                  "label": "Reddet",
                  "requiredFields": [
                    "rejectionReason"
                  ]
                }
              ],
              "assigneeType": "role",
              "assigneeValue": "FinanceApprover"
            }
          ],
          "onCompleteEvent": "PurchaseRequest-approval-completed",
          "trackRevisionHistory": true
        },
        "position": {
          "x": 300,
          "y": 280
        }
      },
      {
        "id": "gen_1789239108279_6",
        "type": "action",
        "label": "Send Approval Email",
        "action": {
          "type": "send-email",
          "config": {
            "to": "{{assigneeEmail}}",
            "body": "<p>Sayın Onaycı,</p><p><strong>{{triggerData.requestNumber}}</strong> numaralı satın alma talebi onayınızı beklemektedir.</p>",
            "subject": "{{triggerData.requestNumber}} — Onayınızı Bekliyor",
            "contentType": "html"
          }
        },
        "position": {
          "x": 300,
          "y": 400
        }
      },
      {
        "id": "gen_1789239108279_8",
        "type": "trigger",
        "label": "On PurchaseRequest Approved",
        "trigger": {
          "type": "manual",
          "resourceName": "PurchaseRequest"
        },
        "position": {
          "x": 700,
          "y": 50
        }
      },
      {
        "id": "gen_1789239108279_9",
        "type": "action",
        "label": "Send Completion Email",
        "action": {
          "type": "send-email",
          "config": {
            "cc": "{{departmentEmails}}",
            "to": "{{creatorEmail}}",
            "body": "<p>{{triggerData.formNo}} numarali formun onay sureci tamamlanmistir.</p>",
            "subject": "{{triggerData.formNo}} — Tum onaylar tamamlandi",
            "contentType": "html"
          }
        },
        "position": {
          "x": 700,
          "y": 160
        }
      }
